      "wdg_rev_by_country": {
        "title": "Receita por país",
        "data": {
          "model": "sem_01J9ZSALES0000000000000000",
          "encodings": {
            "x": [{ "ref": { "model": "sem_01J9ZSALES0000000000000000", "field": "dim_country" } }],
            "y": [{ "ref": { "model": "sem_01J9ZSALES0000000000000000", "field": "met_revenue" } }]
