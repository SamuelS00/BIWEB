        "viz": { "plugin": "core.bar", "version": "2.1.0", "config": { "orientation": "horizontal", "showLabels": true } }
      },
      "wdg_map": {
        "title": "Receita no mapa",
        "data": {
          "model": "sem_01J9ZSALES0000000000000000",
          "encodings": {
            "geo": [{ "ref": { "model": "sem_01J9ZSALES0000000000000000", "field": "dim_country" } }],
            "color": [{ "ref": { "model": "sem_01J9ZSALES0000000000000000", "field": "met_revenue" } }]
          }
        },
        "viz": { "plugin": "core.map", "version": "1.0.0", "config": { "layer": "choropleth", "boundarySet": "world-admin0", "basemap": "light" } }
      }
    },
    "filters": {
      "flt_period": {
        "id": "flt_period", "label": "Período",
        "scope": { "kind": "dashboard" },
        "control": {
          "type": "relative-date",
