{
  "name": "@biweb/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Application Shell (SPA): rotas, home, dados, modelagem, viewer e builder (lazy).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build:static": "VITE_HASH_HISTORY=1 vite build --outDir dist-static",
    "build:artifact": "VITE_HASH_HISTORY=1 VITE_SINGLE_FILE=1 vite build --outDir dist-artifact && node ../../tools/artifact/inline.mjs dist-artifact dist-artifact/page.html"
  },
  "dependencies": {
    "@biweb/tokens": "workspace:*",
    "@biweb/ui": "workspace:*",
    "@tanstack/react-router": "^1.125.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intl": "^7.1.11",
    "zustand": "^5.0.6",
    "@biweb/assistant-ui": "workspace:*",
    "react-aria-components": "^1.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
