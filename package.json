{
  "name": "biweb",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@biweb/web...",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint . && pnpm check:boundaries",
    "lint:strict": "biome lint . --only=all",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "turbo run test",
    "check:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:docs": "node tools/check-docs.mjs",
    "tokens": "turbo run build --filter=@biweb/tokens",
    "e2e": "pnpm --filter @biweb/e2e e2e",
    "e2e:smoke": "pnpm --filter @biweb/e2e e2e:smoke"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "~5.8.3",
    "dependency-cruiser": "^16.10.0",
    "@types/node": "^22.15.0",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
